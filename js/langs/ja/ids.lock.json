 "stories": {
  "s1": [
   "はじめまして。",
   "わたしはけんです。",
   "学生です。",
   "よろしくおねがいします。",
   "はじめまして。わたしはゆきです。",
   "わたしは先生です。",
   "けんさんも日本人ですか。",
   "いいえ、日本人じゃありません。",
   "アメリカ人です。"
  ],
  "s2": [
   "これはなんですか。",
   "それは本です。",
   "だれの本ですか。",
   "わたしの本です。",
   "あれもゆきさんのですか。",
   "いいえ、あれはけんさんのかさですよ。",
   "あ、そうですね。ありがとうございます。"
  ],
  "s3": [
   "わたしはすしがすきです。",
   "ラーメンもすきです。",
   "でも、なっとうはすきじゃありません。",
   "ゆきさんはなっとうがだいすきです。",
   "ゆきさんはまいにちなっとうをたべます。",
   "わたしはまいにちラーメンをたべます。",
   "ラーメンはおいしいですね。",
   "はい、とてもおいしいです！"
  ],
  "s4": [
   "わたしはまいあさ六時におきます。",
   "コーヒーをのみます。",
   "パンをたべます。",
   "それから、しんぶんをよみます。",
   "八時に学校にいきます。",
   "学校で日本語をべんきょうします。",
   "日本語はたのしいです。"
  ],
  "s5": [
   "どようびにともだちとこうえんへいきました。",
   "こうえんはとてもおおきいです。",
   "いぬがたくさんいました。",
   "わたしたちはおべんとうをたべました。",
   "ともだちはしゃしんをとりました。",
   "にちようびはうちでやすみました。",
   "たのしいしゅうまつでした。"
  ],
  "s6": [
   "いらっしゃいませ。",
   "すみません、このりんごはいくらですか。",
   "一つ百円です。",
   "じゃあ、三つください。",
   "三百円です。",
   "はい、どうぞ。",
   "ありがとうございました。"
  ],
  "s7": [
   "これはわたしのへやです。",
   "へやにつくえといすがあります。",
   "つくえのうえにパソコンがあります。",
   "ベッドのしたにねこがいます。",
   "ねこのなまえはミケです。",
   "ミケはよくねます。",
   "ちいさいへやですが、わたしはすきです。"
  ],
  "s8": [
   "わたしは日本へいきたいです。",
   "東京でおいしいすしをたべたいです。",
   "京都でふるいおてらをみたいです。",
   "富士山にものぼりたいです。",
   "だから、まいにち日本語をべんきょうします。",
   "日本語はむずかしいですが、おもしろいです。"
  ],
  "s9": [
   "きのうはあめでした。",
   "とてもさむかったです。",
   "きょうはいいてんきです。",
   "そらがあおいです。",
   "あしたもはれでしょう。",
   "こうえんでさんぽをしましょう。"
  ],
  "s10": [
   "わたしのかぞくは四人です。",
   "ちちとははとあにとわたしです。",
   "ちちはかいしゃいんです。",
   "はははいしゃです。",
   "あにはだいがくせいです。",
   "あにはサッカーがじょうずです。",
   "わたしはサッカーがへたです。",
   "でも、わたしはりょうりがじょうずですよ。"
  ]
 }
